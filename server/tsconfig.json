{
  "compilerOptions": {
    "module": "ESNext",
    "target": "ES2020",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "outDir": "./build",
    "allowSyntheticDefaultImports": true,
    "types": [
      "jest"
    ]
  },
  "include": [
    "src/**/*.ts",
    "__tests__/**/*.ts"
  ]
}